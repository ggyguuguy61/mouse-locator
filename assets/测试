class InstallerApp:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Mouse Locator Setup")
        self.root.geometry("640x480")
        self.root.resizable(False, False)
        self.root.configure(bg="#FFFFFF")

        # 居中
        self.root.update_idletasks()
        sw = self.root.winfo_screenwidth()
        sh = self.root.winfo_screenheight()
        x = (sw - 640) // 2
        y = (sh - 480) // 2
        self.root.geometry(f"640x480+{x}+{y}")

        # 记录所有 after 回调 id，销毁窗口前统一取消
        self._after_ids = []

        self.lang = "zh"
        self.page = 0  # 0=welcome, 1=license, 2=path, 3=components, 4=installing, 5=finish
        self.install_path = os.path.join(os.environ.get("LOCALAPPDATA", ""), "MouseLocator")
        self.var_agree = tk.BooleanVar(value=False)
        self.var_desktop = tk.BooleanVar(value=True)
        self.var_autostart = tk.BooleanVar(value=False)
        self.var_run = tk.BooleanVar(value=True)

        self._build_ui()
        self.lang_var.set("中文")
        self._on_lang_change()
        self._show_page(0)

        # 关闭窗口按钮（X）统一走安全关闭
        self.root.protocol("WM_DELETE_WINDOW", self._safe_destroy)

    def _after(self, ms, func):
        """注册 after 回调并记录 id"""
        aid = self.root.after(ms, func)
        self._after_ids.append(aid)
        return aid

    def _safe_destroy(self):
        """取消所有挂起的 after 回调后销毁窗口，避免 invalid command name"""
        for aid in self._after_ids:
            try:
                self.root.after_cancel(aid)
            except Exception:
                pass
        self._after_ids.clear()
        try:
            self.root.update_idletasks()
        except Exception:
            pass
        try:
            self.root.destroy()
        except Exception:
            pass

