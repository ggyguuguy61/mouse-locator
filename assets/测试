        self.btn_prev.config(state="normal" if idx in (1, 2, 3) else "disabled")
        if idx == 4:
            self.btn_next.config(state="disabled")
            self.btn_prev.config(state="disabled")
            self.btn_cancel.config(state="disabled")
        elif idx == 5:
            self.btn_next.config(text=self.t("finish"))
            self.btn_prev.config(state="disabled")
            self.btn_cancel.config(state="disabled")
