    def _do_install(self):
        try:
            # 注意：此时页面已切到安装页，路径输入框已被销毁，
            # 不能访问 self.path_entry。安装路径在 _on_next(page==2) 时已存到 self.install_path
            if not self.install_path:
                self.install_path = os.path.join(os.environ.get("LOCALAPPDATA", ""), "MouseLocator")

            # 1. 复制文件
            self.status_label.config(text=self.t("install_files"))
            self.progress.config(value=20)
            self.root.update()

            src = resource_path("program")
            # 1.1 先停掉正在运行的 MouseLocator（开机自启可能导致文件被占用，
            #     之前因此 rmtree 只删一半、copytree 失败，造成安装目录残缺）
            try:
                subprocess.run(["taskkill", "/IM", "MouseLocator.exe", "/F"],
                               capture_output=True, timeout=10)
            except Exception:
                pass
            # 1.2 删除旧目录，若失败重试几次
            if os.path.exists(self.install_path):
                for _ in range(3):
                    shutil.rmtree(self.install_path, ignore_errors=True)
                    if not os.path.exists(self.install_path):
                        break
                    time.sleep(0.5)
            # 1.3 复制新程序（确保目标不存在）
            if os.path.exists(self.install_path):
                raise RuntimeError("无法删除旧安装目录，请关闭鼠标定位器后重试")
            shutil.copytree(src, self.install_path)

            # 1.4 校验关键文件，防止安装不完整
            exe_path = os.path.join(self.install_path, "MouseLocator.exe")
            if not os.path.exists(exe_path):
                raise RuntimeError("安装不完整：主程序文件缺失")
            internal_dir = os.path.join(self.install_path, "_internal")
            if not os.path.exists(internal_dir) or \
               not os.path.exists(os.path.join(internal_dir, "python314.dll")) or \
               not os.path.exists(os.path.join(internal_dir, "base_library.zip")):
                raise RuntimeError("安装不完整：程序依赖文件缺失")

            # 2. 桌面快捷方式
            if self.var_desktop.get():
                self.status_label.config(text=self.t("install_shortcut"))
                self.progress.config(value=55)
                self.root.update()
                desktop = os.path.join(os.environ["USERPROFILE"], "Desktop")
                lnk_name = "鼠标定位器.lnk" if self.lang == "zh" else "Mouse Locator.lnk"
                create_shortcut(exe_path, os.path.join(desktop, lnk_name), exe_path + ",0")

            # 3. 开机自启动
            if self.var_autostart.get():
                self.status_label.config(text=self.t("install_registry"))
                self.progress.config(value=80)
                self.root.update()
                set_autostart(exe_path, True)

            # 4. 注册卸载
            register_uninstall(self.install_path, exe_path,
                               "鼠标定位器 v2.3 beta" if self.lang == "zh" else "Mouse Locator v2.3 beta")

            self.progress.config(value=100)
            self.status_label.config(text=self.t("install_done"))
            self.root.update()
            self._after(800, lambda: self._show_page(5))

        except Exception as e:
            messagebox.showerror("Error", str(e))
            self._show_page(5)

