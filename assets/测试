                       bg="#FFFFFF", fg="#333", font=("Microsoft YaHei UI", 10),
                       selectcolor="#FFFFFF", activebackground="#FFFFFF", cursor="hand2").pack(anchor="w", pady=16)

    # ---- 按钮事件 ----
    def _on_next(self):
        if self.page == 0:
            self._show_page(1)
        elif self.page == 1:
            if not self.var_agree.get():
                msg = "请先同意许可协议" if self.lang == "zh" else "Please accept the license agreement first"
                messagebox.showwarning("Warning", msg)
                return
            self._show_page(2)
        elif self.page == 2:
            path = self.path_entry.get().strip()
            if not path:
                return
            if not os.path.exists(path):
                msg = self.t("path_not_exist")
                if messagebox.askyesno("Confirm", msg):
                    os.makedirs(path, exist_ok=True)
                else:
                    return
            self.install_path = path
            self._show_page(3)
        elif self.page == 3:
            self._show_page(4)
        elif self.page == 5:
            if self.var_run.get():
                try:
                    exe_path = os.path.join(self.install_path, "MouseLocator.exe")
                    if os.path.exists(exe_path):
                        os.startfile(exe_path)
                except Exception:
                    pass
            self._safe_destroy()

    def _on_prev(self):
        if self.page > 0 and self.page < 4:
            self._show_page(self.page - 1)

    def _on_cancel(self):
        if messagebox.askyesno("Confirm", self.t("cancel_confirm")):
            self._safe_destroy()

    def run(self):
        self.root.mainloop()

if __name__ == "__main__":
    app = InstallerApp()
    app.run()

